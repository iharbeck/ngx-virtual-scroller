{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@iharbeck/ngx-virtual-scroller": [
        "../dist/ngx-virtual-scroller"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
